/*  Faust QT dark theme (Luca Spanedda)
 *
 *  Used by faust2caqt / faust2jaqt (GreyDark.qss is loaded from Grey.qrc, compiled into each app).
 *  Colors of knobs and bargraphs are painted in C++: see the THEME block at the
 *  top of faust/gui/QTUI.h and keep the two in sync.
 *
 *  Palette
 *    window      #1c1c1e     card        #2a2a2d     border   #3d3d42
 *    text        #f2f2f4     text dim    #9a9aa0     accent   #f2f2f4
 *    track       #3a3a3f
 */

/* ---------- base ---------- */

QMainWindow, QScrollArea, QScrollArea > QWidget > QWidget, QTGUI {
    background-color: #1c1c1e;
}

QWidget {
    color: #f2f2f4;
    font-size: 11px;
}

QToolTip {
    background-color: #f2f2f4;
    color: #1c1c1e;
    border: none;
    padding: 4px 6px;
}

/* ---------- groups (hgroup / vgroup) ---------- */

QGroupBox {
    background-color: #2a2a2d;
    border: 1px solid #3d3d42;
    border-radius: 6px;
    margin-top: 14px;           /* room for the title */
    padding: 2px;
    font-weight: 600;
}

/* groups inside groups: flat, so that nesting does not eat space */
QGroupBox QGroupBox {
    background-color: transparent;
    border: 1px solid #38383c;
    border-radius: 4px;
    font-weight: 500;
}

/* third level and deeper: caption only, the frame would only eat space */
QGroupBox QGroupBox QGroupBox {
    border: none;
    margin-top: 12px;
    padding: 0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 6px;
    padding: 0 3px;
    color: #9a9aa0;
}

QGroupBox#topGroup::title {
    color: #f2f2f4;
}

/* box around a single control: only its caption, no frame */
QGroupBox#control, QGroupBox QGroupBox#control {
    background-color: transparent;
    border: none;
    margin-top: 12px;
    padding: 0;
    font-weight: normal;
}

QGroupBox#control::title {
    left: 2px;
    padding: 0;
    color: #d0d0d4;
}

/* ---------- pages (tgroup) ---------- */

QTabWidget::pane {
    background-color: #2a2a2d;
    border: 1px solid #3d3d42;
    border-radius: 6px;
    top: -1px;
}

QTabWidget::tab-bar {
    alignment: left;
    left: 6px;
}

QWidget#tabPage {
    background-color: #2a2a2d;
}

QTabBar::tab {
    background-color: #232326;
    color: #d0d0d4;
    border: 1px solid #3d3d42;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 3px 10px;
    margin-right: 2px;
    min-width: 40px;
}

QTabBar::tab:hover {
    background-color: #303034;
}

QTabBar::tab:selected {
    background-color: #2a2a2d;
    color: #f2f2f4;
    font-weight: 600;
}

/* ---------- sliders ---------- */

QSlider::groove:horizontal {
    height: 4px;
    background: #3a3a3f;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {     /* left part = value */
    background: #f2f2f4;
    border-radius: 2px;
}

QSlider::add-page:horizontal {
    background: #3a3a3f;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    border-radius: 7px;
    background: #2a2a2d;
    border: 1px solid #5a5a60;
}

QSlider::groove:vertical {
    width: 4px;
    background: #3a3a3f;
    border-radius: 2px;
}

QSlider::add-page:vertical {       /* bottom part = value */
    background: #f2f2f4;
    border-radius: 2px;
}

QSlider::sub-page:vertical {
    background: #3a3a3f;
    border-radius: 2px;
}

QSlider::handle:vertical {
    height: 14px;
    margin: 0 -6px;
    border-radius: 7px;
    background: #2a2a2d;
    border: 1px solid #5a5a60;
}

QSlider::handle:hover, QSlider::handle:focus {
    border: 1px solid #f2f2f4;
}

/* ---------- numbers (value under sliders/knobs, numerical bargraphs) ---------- */

QDoubleSpinBox#numDisplay {
    background-color: transparent;
    border: none;
    color: #d0d0d4;
    font-size: 10px;
    padding: 0;
    min-width: 52px;
}

/* nentry */
QDoubleSpinBox {
    background-color: #2a2a2d;
    border: 1px solid #3d3d42;
    border-radius: 4px;
    padding: 1px 2px;
    selection-background-color: #f2f2f4;
}

QDoubleSpinBox:focus {
    border: 1px solid #f2f2f4;
}

/* ---------- buttons, checkboxes, menus, radio ---------- */

QPushButton {
    background-color: #2a2a2d;
    border: 1px solid #4a4a50;
    border-radius: 5px;
    padding: 3px 10px;
    min-width: 40px;
}

QPushButton:hover {
    border-color: #f2f2f4;
}

QPushButton:pressed {
    background-color: #f2f2f4;
    border-color: #f2f2f4;
    color: #2a2a2d;
}

QCheckBox, QRadioButton {
    spacing: 5px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 13px;
    height: 13px;
    background: #2a2a2d;
    border: 1px solid #5a5a60;
}

QCheckBox::indicator { border-radius: 3px; }
QRadioButton::indicator { border-radius: 7px; }

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #f2f2f4;
    border-color: #f2f2f4;
}

QComboBox {
    background-color: #2a2a2d;
    border: 1px solid #4a4a50;
    border-radius: 4px;
    padding: 1px 6px;
}

QComboBox:hover {
    border-color: #f2f2f4;
}

/* ---------- scrollbars (only when the interface is larger than the screen) ---------- */

QScrollBar:vertical, QScrollBar:horizontal {
    background: transparent;
    border: none;
    margin: 0;
}

QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }

QScrollBar::handle {
    background: #4a4a50;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical { min-height: 30px; }
QScrollBar::handle:horizontal { min-width: 30px; }

QScrollBar::handle:hover {
    background: #7a7a80;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}

/* ---------- theme button (top right corner) ---------- */

QToolButton#themeButton {
    background-color: #2a2a2d;
    color: #d0d0d4;
    border: 1px solid #4a4a50;
    border-radius: 11px;
    font-size: 13px;
    padding: 0;
}

QToolButton#themeButton:hover {
    border-color: #d0d0d4;
}
